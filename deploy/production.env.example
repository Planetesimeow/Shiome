# Copy to .env.production at the repository root. Docker Compose reads it RAW:
# paste values without quotes, without replacing $ with $$.
SHIOME_PASSWORD_HASH=
SHIOME_SECRET_KEY=
SHIOME_DB_PATH=/data/shiome.db
SHIOME_MONTHLY_BUDGET_USD=20
ANTHROPIC_API_KEY=
# Optional Gemini vision: set VISION_PROVIDER=gemini and GEMINI_API_KEY.
# VISION_PROVIDER=gemini
# GEMINI_API_KEY=
# SHIOME_API_TOKEN=
