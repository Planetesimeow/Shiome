# Personal pilot: copy to .env.production at the repository root.
# Raw values only: no quotes and no escaping the $ in the password hash.
SHIOME_PASSWORD_HASH=
SHIOME_SECRET_KEY=
SHIOME_DB_PATH=/data/shiome.db

# USD, not CNY. This is a small monthly AI allowance, separate from hosting.
# Checked against recorded spend before each call, not a guaranteed billing hard cap.
SHIOME_MONTHLY_BUDGET_USD=0.75
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-haiku-4-5-20251001
VISION_PROVIDER=anthropic
VISION_MODEL=claude-sonnet-4-6
