# Secrets — never commit real keys
.env
.env.*
!.env.example

# Local data (SQLite DB + anything under app/data)
app/data/
*.db
*.sqlite
*.sqlite3

# Test artifacts — never upload test results (dated *_Test files live here)
test_output/

# Source logo originals (~4MB); app serves the small processed copies in app/static/img/
/image/

# Real account data — creator-center exports & screenshots dropped in for analysis/design
data_inbox/
reference/
videodata/
userscreenshots/
work/
node_modules/
*.xlsx
*.xls

# Python
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local working agreement for AI collaborators — stays local, not public docs
CLAUDE.md
CLAUDE.local.md

# OS / editor junk
.DS_Store
.idea/
.vscode/
