# 复制这个文件为 .env，填入你自己的值
# cp .env.example .env

# 必填：你的 Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：分析用的模型，默认见 app/analysis/prompts.py（默认 claude-haiku-4-5-20251001）
# 想要更强的推理质量可换成 claude-sonnet-4-6 或 claude-opus-4-8
ANALYSIS_MODEL=claude-haiku-4-5-20251001

# ---- 截图提取（vision）模型插槽，与上面的文本分析模型解耦 ----
# VISION_PROVIDER: anthropic（默认，用下面 VISION_MODEL，缺省 claude-sonnet-4-6）
#                  或 gemini（需要 GEMINI_API_KEY，缺省 gemini-3.5-flash）
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-3.5-flash
# GEMINI_API_KEY=你的_Google_AI_Studio_key（https://aistudio.google.com/apikey）
