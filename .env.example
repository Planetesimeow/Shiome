# 复制这个文件为 .env，填入你自己的值
# cp .env.example .env

# 首次网页设置需要共享密钥；可在此配置，或在管理员初始化页面输入一次。
# 浏览和手动录入不调用付费模型。
ANTHROPIC_API_KEY=

# 分析和截图默认使用 Sonnet 5；环境变量可分别覆盖。
ANALYSIS_MODEL=claude-sonnet-5
VISION_MODEL=claude-sonnet-5

# ---- 截图提取（vision）模型插槽，与上面的文本分析模型解耦 ----
# VISION_PROVIDER: anthropic（默认，缺省 claude-sonnet-5）
#                  或 gemini（需要 GEMINI_API_KEY，缺省 gemini-3.5-flash）
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-3.5-flash
# GEMINI_API_KEY=你的_Google_AI_Studio_key（https://aistudio.google.com/apikey）

# ---- 每月 API 预算上限（美元）----
# 不设 = 不限额（花销依然统计，见 GET /api/usage）。部署到服务器上建议设一个：
# 超过上限后分析和截图提取会被拒绝，下个月自动重置。
# SHIOME_MONTHLY_BUDGET_USD=20
# 价目表过期时可以按模型覆盖，不用改代码：
# SHIOME_PRICE_CLAUDE_HAIKU_4_5=1,5

# ---- 鉴权（远程部署前必须配；不配则只接受本机访问）----
# 用 python -m scripts.set_password 生成下面三行
# SHIOME_PASSWORD_HASH=scrypt$...$...
# SHIOME_SECRET_KEY=会话签名密钥；不设则从口令哈希派生（改口令会踢掉所有会话）
# SHIOME_API_TOKEN=给脚本/手机快捷指令用的 Bearer token（可选）
# SHIOME_SESSION_DAYS=30
